# =============================================================
# iTAS BackOffice System — Environment Variables
# Copy this file to .env.local for development
# =============================================================

# ---- App ----
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="iTAS BackOffice"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ---- Database ----
DATABASE_URL="postgresql://itas_user:strongpassword@localhost:5432/itas_backoffice?schema=public"
DATABASE_URL_SHADOW="postgresql://itas_user:strongpassword@localhost:5432/itas_backoffice_shadow?schema=public"

# ---- Auth (NextAuth.js v5) ----
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-in-production"
NEXTAUTH_URL=http://localhost:3000
JWT_ACCESS_SECRET="jwt-access-secret-change-in-production"
JWT_REFRESH_SECRET="jwt-refresh-secret-change-in-production"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- S3 Storage (MinIO for dev / AWS S3 for prod) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=itas-backoffice
S3_PUBLIC_URL=http://localhost:9000/itas-backoffice

# ---- Email (Nodemailer / Resend) ----
EMAIL_PROVIDER=smtp                        # smtp | resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@itas.co.th
SMTP_PASS=your-app-password
EMAIL_FROM="iTAS System <noreply@itas.co.th>"

# Resend (alternative)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# ---- Notifications ----
NOTIFICATION_EXPIRY_DAYS_WARNING=90        # Days before expiry to start alerting
NOTIFICATION_EXPIRY_DAYS_CRITICAL=30
NOTIFICATION_CRON_SCHEDULE="0 8 * * *"    # Daily at 08:00

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=60000                 # 1 minute
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10                     # Stricter for auth endpoints

# ---- File Upload ----
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf,xlsx,xls,doc,docx,png,jpg,jpeg,gif,zip

# ---- QR Code ----
QR_CODE_BASE_URL=http://localhost:3000     # Base URL for QR scan redirects

# ---- Logging ----
LOG_LEVEL=debug                            # debug | info | warn | error

# ---- Redis (Optional — for caching & rate limiting) ----
REDIS_URL=redis://localhost:6379

# ---- Company Branding (for PDF/Certificate generation) ----
COMPANY_NAME="iTAS Co., Ltd."
COMPANY_ADDRESS="123 Example Road, Bangkok 10110, Thailand"
COMPANY_PHONE="+66 2 123 4567"
COMPANY_EMAIL="support@itas.co.th"
COMPANY_WEBSITE="https://www.itas.co.th"
COMPANY_TAX_ID="0105563000000"
COMPANY_LOGO_URL="/images/logo.png"
